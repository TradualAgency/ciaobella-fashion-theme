<!-- /snippets/product-title-price.liquid -->

{%- assign current_variant = product.selected_or_first_available_variant -%}

<div class="product__headline {{ classes }}" {{ block.shopify_attributes }}>
  {% if block.settings.product_show_vendor %}
    <div class="product__subheading">
      <p>
        <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a>
      </p>
    </div>
  {% endif %}

  <div class="product__title__wrapper">
    {% assign heading_size_class = block.settings.text_size | prepend: 'heading-size-' %}

    {% if template contains 'product' %}
      <div class="product__trustpilot-static">
        <img src="https://cdn.shopify.com/s/files/1/0651/3541/1427/files/stars-5.svg?v=1776158727" alt="5 sterren" height="20" loading="lazy">
        <span><strong>4.8/5</strong> Uitstekend 400+ reviews</span>
      </div>
      <h1 class="product__title {{ heading_size_class }}">{{ product.title | strip_html }}</h1>
    {% else %}
      <h3 class="product__title">
        <a href="{{ product.url }}">{{ product.title | strip_html }}</a>
      </h3>
    {% endif %}

  </div>

  {%- if product.metafields.theme.cutline != blank and product.metafields.theme.cutline.type == 'single_line_text_field' and block.settings.product_show_cutline -%}
    <p class="product__cutline">{{ product.metafields.theme.cutline.value }}</p>
  {%- endif -%}

  {%- liquid
    assign src_price = current_variant.price
    assign src_compare = current_variant.compare_at_price
    assign storewide_pct = settings.storewide_discount_percent | default: 0
    if settings.storewide_discount_enable and storewide_pct > 0
      assign multiplier = 100 | minus: storewide_pct
      assign display_price = src_price | times: multiplier | divided_by: 100
      if src_compare == blank or src_compare < src_price
        assign display_compare = src_price
      else
        assign display_compare = src_compare
      endif
    else
      assign display_price = src_price
      assign display_compare = src_compare
    endif
    assign pdp_on_sale = false
    if display_compare > display_price
      assign pdp_on_sale = true
    endif
  -%}

  <div class="product__price__wrap"{% if settings.storewide_discount_enable and settings.storewide_discount_percent > 0 %} data-storewide-discount="{{ settings.storewide_discount_percent }}"{% endif %}>
    <div class="product__price__main" data-price-wrapper>
      <span class="product__price">
        <span data-product-price {% if pdp_on_sale %} class="product__price--sale"{% endif %}>
          {%- if settings.currency_code_enable -%}
            {{ display_price | money_with_currency }}
          {%- else -%}
            {{ display_price | money }}
          {%- endif -%}
        </span>
      </span>

      {%- if pdp_on_sale -%}
        <span class="product__price--compare">
          <s>
            {%- if settings.currency_code_enable -%}
              {{ display_compare | money_with_currency }}
            {%- else -%}
              {{ display_compare | money }}
            {%- endif -%}
          </s>
        </span>
      {%- endif -%}

      <span data-price-off class="product__price--off hide">
        <span data-price-off-type>{{ 'products.product.sale' | t }}</span>
        <em>•</em>
        {{ 'products.product.save' | t }}
        <span data-price-off-amount></span>
      </span>

      {% liquid
        assign units = product.variants | map: 'unit_price' | compact
        if units[0]
          assign has_units = true
        else
          assign has_units = false
        endif
      %}
      {% if has_units %}
        {% capture show_units %}
          {%- unless current_variant.unit_price -%}style="display: none;"{%- endunless -%}
        {% endcapture %}
        {% capture unit_price_separator %}
          <span aria-hidden="true">/</span><span class="visually-hidden">{{ 'general.accessibility.unit_price_separator' | t }}&nbsp;</span>
        {% endcapture %}
        {% capture unit_price_base_unit %}
          <span>
            {% if current_variant.unit_price_measurement %}
              {% if current_variant.unit_price_measurement.reference_value != 1 %}
                {{ current_variant.unit_price_measurement.reference_value }}
              {%- endif -%}
              {{ current_variant.unit_price_measurement.reference_unit }}
            {% endif %}
          </span>
        {% endcapture %}
        <div class="product__price--unit">
          <span data-product-unit {{ show_units }}>
            <span class="visually-hidden visually-hidden--inline">{{ 'products.product.unit_price_label' | t }}</span>
            <span data-product-unit-price id="unit-price-{{ block.id }}">
              {%- if settings.currency_code_enable -%}
                {{ current_variant.unit_price | money_with_currency }}
              {%- else -%}
                {{ current_variant.unit_price | money }}
              {%- endif -%}
            </span>
            {{ unit_price_separator }}
            <span data-product-base id="unit-price-base-{{ block.id }}">{{ unit_price_base_unit }}</span>
          </span>
          <span data-price-each class="hide">
            {{ 'products.product.each' | t }}
            <span data-price-each-amount></span>
          </span>
        </div>
      {% endif %}
    </div>
  </div>

  {%- if settings.storewide_discount_enable and settings.storewide_discount_percent > 0 -%}
    <script>
      (function() {
        if (window.__storewideDiscountInit) return;
        window.__storewideDiscountInit = true;
        var pct = {{ settings.storewide_discount_percent }};
        document.addEventListener('theme:variant:change', function(e) {
          var variant = e.detail && e.detail.variant;
          if (!variant || pct <= 0) return;
          var root = e.target;
          while (root && root !== document.body && !root.querySelector('[data-storewide-discount]')) {
            root = root.parentElement;
          }
          var priceWrap = root ? root.querySelector('[data-storewide-discount]') : document.querySelector('[data-storewide-discount]');
          if (!priceWrap) return;
          var priceEl = priceWrap.querySelector('[data-product-price]');
          var compareEl = priceWrap.querySelector('.product__price--compare');
          if (!priceEl) return;
          var discountedPrice = Math.floor(variant.price * (100 - pct) / 100);
          var displayCompare = (variant.compare_at_price && variant.compare_at_price > variant.price) ? variant.compare_at_price : variant.price;
          var fmt = function(cents) {
            var f = window.themeCurrency ? themeCurrency.formatMoney(cents, theme.moneyFormat) : String(cents);
            return (window.theme && theme.settings && theme.settings.currency_code_enable) ? f + ' ' + theme.currencyCode : f;
          };
          priceEl.innerHTML = fmt(discountedPrice);
          priceEl.classList.add('product__price--sale');
          if (compareEl) {
            compareEl.style.display = '';
            var s = compareEl.querySelector('s');
            if (s) s.innerHTML = fmt(displayCompare);
          }
        });
      })();
    </script>
  {%- endif -%}

  {%- if template contains 'product' -%}
    <div class="product__shipping-info">
      <svg width="13" height="12" viewBox="0 0 13 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M9.28362 1.5C9.28362 0.671573 9.95519 0 10.7836 0C11.612 0 12.2836 0.671573 12.2836 1.5V10.0673V11.5673H10.7836H2.21631C1.38788 11.5673 0.716309 10.8957 0.716309 10.0673C0.716309 9.23888 1.38788 8.56731 2.21631 8.56731H7.56687L2.10755 3.10799C1.52176 2.5222 1.52176 1.57246 2.10755 0.986669C2.69334 0.400882 3.64308 0.400882 4.22887 0.986669L9.28362 6.04141V1.5Z" fill="currentColor"/></svg>
      <p><strong>{{ 'products.product.free_shipping_notice' | t }}</strong></p>
      <p>{{ 'products.product.delivery_notice' | t }}</p>
    </div>
  {%- endif -%}
</div>
